# Database
POSTGRES_USER=kinara
POSTGRES_PASSWORD=change_me_in_production

# JWT Keys (generate with: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY_PATH=/etc/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/etc/jwt/public.pem

# AES-256-GCM key (generate with: openssl rand -hex 32)
AES_KEY=change_me_32_byte_hex_key_here_00

# SMS Providers
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
AFRICASTALKING_API_KEY=your_africastalking_key
AFRICASTALKING_USERNAME=kinara

# Monitoring
GRAFANA_PASSWORD=kinara2026

